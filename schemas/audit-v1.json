{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Uplift Audit Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "mode",
    "readiness",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "minLength": 10 },
    "repository": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["local", "github"] },
    "readiness": {
      "type": "object",
      "required": [
        "score",
        "autonomy",
        "passed",
        "improve",
        "missing",
        "waiting",
        "total",
        "blockers",
        "groups"
      ],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "autonomy": { "enum": ["not-ready", "supervised", "autonomous-ready"] },
        "passed": { "type": "integer", "minimum": 0 },
        "improve": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "waiting": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "score", "passed", "total"]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "title",
          "kind",
          "impact",
          "blocks_autonomy",
          "status",
          "evidence",
          "why",
          "recommendation",
          "verify_command",
          "fixes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["setup", "habit"] },
          "impact": { "enum": ["high", "medium", "low"] },
          "blocks_autonomy": { "type": "boolean" },
          "status": { "enum": ["pass", "improve", "missing", "waiting"] },
          "verify_command": { "type": "string" },
          "fixes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "language", "content"]
            }
          }
        }
      }
    },
    "manual_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "status", "why", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "github-settings",
              "labels",
              "secrets",
              "local-hooks",
              "proof-seal"
            ]
          },
          "status": { "enum": ["required", "recommended", "done"] },
          "check_id": { "type": ["string", "null"] },
          "why": { "type": "string" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
